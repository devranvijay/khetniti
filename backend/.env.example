# Copy to backend/.env and fill in. Never commit the real .env.

# data.gov.in API key for live AGMARKNET mandi prices (https://data.gov.in → My Account → API key).
# Without it, prices come only from AGMARKNET CSV imports (scripts/import_agmarknet_csv.py).
DATA_GOV_IN_API_KEY=

# PostgreSQL for production (required on Vercel). Leave unset to use a local SQLite file (backend/khetniti.db).
# Supabase: Project -> Connect -> "Session pooler" URI, pasted as shown (postgresql://... works as is).
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# Any long random string. Vercel Cron sends it to /api/cron/refresh-prices once a day (see vercel.json).
# CRON_SECRET=
