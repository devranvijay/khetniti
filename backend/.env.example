# Copy to backend/.env and fill in. Never commit the real .env.

# data.gov.in API key for live AGMARKNET mandi prices (https://data.gov.in → My Account → API key).
# Leave empty to run with the clearly labelled DEMO dataset.
DATA_GOV_IN_API_KEY=

# PostgreSQL for production. Leave unset to use a local SQLite file (backend/khetniti.db).
# DATABASE_URL=postgresql+psycopg://khetniti:password@localhost:5432/khetniti

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
